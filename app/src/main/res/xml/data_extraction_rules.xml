<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above: the cloud backup and the transfer to a new device. Everything goes as before,
  except the recycle bin's database (the text of deleted messages). Keep the name in step with
  BinDatabase.NAME and backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="pigeon-bin.db" />
        <exclude domain="database" path="pigeon-bin.db-shm" />
        <exclude domain="database" path="pigeon-bin.db-wal" />
        <exclude domain="database" path="pigeon-bin.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="pigeon-bin.db" />
        <exclude domain="database" path="pigeon-bin.db-shm" />
        <exclude domain="database" path="pigeon-bin.db-wal" />
        <exclude domain="database" path="pigeon-bin.db-journal" />
    </device-transfer>
</data-extraction-rules>
