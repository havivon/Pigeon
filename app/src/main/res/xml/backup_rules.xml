<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below. Everything backs up as before, except the recycle bin's database: it holds the
  text of deleted messages, which should not outlive their 30 days in a backup. Keep the name in step
  with BinDatabase.NAME.
-->
<full-backup-content>
    <exclude domain="database" path="pigeon-bin.db" />
    <exclude domain="database" path="pigeon-bin.db-shm" />
    <exclude domain="database" path="pigeon-bin.db-wal" />
    <exclude domain="database" path="pigeon-bin.db-journal" />
</full-backup-content>
