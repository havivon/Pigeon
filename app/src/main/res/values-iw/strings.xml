    <!-- onboarding_ -->
    <string name="onboarding_welcome_title">ברוכים הבאים ל-Pigeon</string>
    <string name="onboarding_welcome_body">הפוך את Pigeon לאפליקציית ההודעות של הטלפון כדי לקבל ולשלוח כאן, או רק הצג בה את ההודעות שלך בזמן שהאפליקציה הנוכחית ממשיכה לקבל אותן. אפשר לשנות את זה בכל רגע דרך ההגדרות.</string>
    <string name="onboarding_benefit_colors">צבעים לפי שולח או נושא</string>
    <string name="onboarding_benefit_spam">ספאם מועבר הצידה אוטומטית</string>
    <string name="onboarding_benefit_offline">בלי אינטרנט, כך שההודעות לא יוצאות מהטלפון לעולם</string>
    <string name="onboarding_make_default">הפוך את Pigeon לאפליקציית ההודעות שלי</string>
    <string name="onboarding_view_only">רק הצג את ההודעות שלי</string>
    <string name="onboarding_not_now">לא עכשיו</string>
    <string name="onboarding_restricted_title">צריך לאשר את Pigeon פעם אחת</string>
    <string name="onboarding_restricted_body">אנדרואיד לא נותן לאפליקציה שהותקנה מקובץ להפוך לאפליקציית ההודעות או לקרוא את ההודעות שלך, עד שמאשרים אותה. זה לוקח חצי דקה:</string>
    <string name="onboarding_restricted_step1">הקש למטה על \"פתח את פרטי האפליקציה\".</string>
    <string name="onboarding_restricted_step2">הקש על ⋮ למעלה, ואז על \"הגדרות מוגבלות\" (Allow restricted settings), ואשר בטביעת אצבע או בנעילת המסך.</string>
    <string name="onboarding_restricted_step3">חזור לכאן והקש \"אישרתי, נסה שוב\".</string>
    <string name="onboarding_restricted_open">פתח את פרטי האפליקציה</string>
    <string name="onboarding_restricted_retry">אישרתי, נסה שוב</string>
    <string name="onboarding_restricted_close">סגור</string>
    <string name="onboarding_reminder_title">Pigeon עדיין לא אפליקציית ההודעות שלך</string>
    <string name="onboarding_reminder_body">הפוך אותה לאפליקציית ההודעות כדי לקבל כאן הודעות, או רק הצג בה את ההודעות בזמן שהאפליקציה הנוכחית ממשיכה לקבל אותן.</string>

