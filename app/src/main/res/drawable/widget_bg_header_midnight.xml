<?xml version="1.0" encoding="utf-8"?>
<!-- The header band of the list widgets, in the Midnight skin (its day and night colours are in widget_colors.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="@color/widget_midnight_gradient_center"
        android:endColor="@color/widget_midnight_gradient_end"
        android:startColor="@color/widget_midnight_gradient_start"
        android:type="linear" />
    <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
</shape>
