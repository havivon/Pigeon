<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission, on purpose: nothing the app holds can leave the phone. -->

    <!-- Settings (rules, favourites) follow the user to a new phone through Android's encrypted backup -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- One launcher entry per icon choice; settings enables exactly one (AppIconSwitcher). -->
        <activity-alias
            android:name=".IconEnvelope"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconOrigami"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_origami"
            android:roundIcon="@mipmap/ic_launcher_origami"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBubble"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bubble"
            android:roundIcon="@mipmap/ic_launcher_bubble"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Home-screen widgets. The widget framework requires the receivers to be exported; they only accept the system update broadcast. -->
        <receiver
            android:name=".widget.UnreadWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_unread_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unread_info" />
        </receiver>
        <receiver
            android:name=".widget.CodeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_code_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_code_info" />
        </receiver>
        <receiver
            android:name=".widget.ContactsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_contacts_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_contacts_info" />
        </receiver>
        <receiver
            android:name=".widget.CounterWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_counter_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_counter_info" />
        </receiver>
        <receiver
            android:name=".widget.FavoritesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_favorites_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_favorites_info" />
        </receiver>
    </application>
</manifest>
